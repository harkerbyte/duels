# Your own shadeDB. Copy this file to .env, fill it in, then run ./start.sh --custom
# (plain ./start.sh writes its own .env for the shared demo database instead).
# Leave the tokens empty, or run ./start.sh --offline, to play with local storage.
# Never commit .env.
SHADEDB_ENDPOINT=https://shadedb.duckdns.org/connect/YOUR_INSTANCE_ID
SHADEDB_DBID=YOUR_DBID
SHADEDB_CONNECTION_TOKEN=
SHADEDB_CLUSTER_TOKEN=
SHADEDB_PARTITION=duelers
PORT=5000
